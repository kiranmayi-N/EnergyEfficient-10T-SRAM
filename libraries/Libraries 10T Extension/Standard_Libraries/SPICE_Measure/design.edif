			(view DelayNonInverting
				(viewType SCHEMATIC)
				(interface
					(port Vin)
					(port Vout)
					(property
						(rename BDA_PERIOD_OUTPUT "BDA.OUTPUT")
						(string ".MEASURE TRAN RiseDelay_${Name} TRIG v(%37%{Vin}) VAL='${Calc.StartVoltage}' TD='${Delay}' RISE=1 TARG v(%37%{Vout}) VAL='${Calc.EndVoltage}' TD='${Delay}' FALL=1\n.MEASURE TRAN FallDelay_${Name} TRIG v(%37%{Vin}) VAL='${Calc.StartVoltage}' TD='${Delay}' FALL=1 TARG v(%37%{Vout}) VAL='${Calc.EndVoltage}' TD='${Delay}' RISE=1\n.MEASURE TRAN ${MeasureName} PARAM='(RiseDelay_${Name}+FallDelay_${Name})/2.0'")
						(property InterfaceParameter
							(boolean
								(false)
							)
						)
					)
					(property
						(rename Calc_PERIOD_EndVoltage "Calc.EndVoltage")
						(string "${Calc.TotalVoltage}*${EndTrigger}/100+${MinVoltage}")
						(property InterfaceParameter
							(boolean
								(false)
							)
						)
						(property Type
							(string "Double")
						)
					)
					(property
						(rename Calc_PERIOD_StartVoltage "Calc.StartVoltage")
						(string "${Calc.TotalVoltage}*${StartTrigger}/100+${MinVoltage}")
						(property InterfaceParameter
							(boolean
								(false)
							)
						)
						(property Type
							(string "Double")
						)
					)
					(property
						(rename Calc_PERIOD_TotalVoltage "Calc.TotalVoltage")
						(string "(${MaxVoltage}-${MinVoltage})")
						(property InterfaceParameter
							(boolean
								(false)
							)
						)
						(property Type
							(string "Double")
						)
					)
					(property Delay
						(string "0s")
						(property Type
							(string "Double")
						)
					)
