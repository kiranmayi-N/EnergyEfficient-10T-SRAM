				(property text
					(string "%13  10%`include %34%constants.h%34%			// Include Files%13  10%`include %34%discipline.h%34  13  10%`define NUM_OF_BINS 100%13  10  13  10%module TRAN_Measure_Dynamic_RiseFallTime(NodeToMeasure);%13  10%input NodeToMeasure;%13  10%electrical NodeToMeasure;%13  10  13  10%// Baseline & Topline parameters%13  10%parameter real StableFrom = 0.0 from [0:inf);		// Start calculating the baseline and topline in the interval [StableFrom, StableTo]%13  10%parameter real StableTo = 0.0 from [0:inf);			// Start calculating the baseline and topline in the interval [StableFrom, StableTo].  If StableTo is equal to 0, then it means the end of the simulation.%13  10%parameter real SamplePeriod = 0.0 from [0:inf);		// This is the sampling period for histogram.  If this is zero, then sampling interval is divided by NumOfSamples for SamplePeriod.%13  10%parameter integer NumOfSamples = 2000 from (0:inf);	// Number of samples to use to calculate the SamplePeriod. SamplePeriod = (StableTo - StabelFrom)/NumOfSamples%13  10  13  10%// Measurement Parameters%13  10%parameter real LowerThreshold = 20.0 from [0:100];	// Lower threshold for the rise/fall time calculation in percent.%13  10%parameter real UpperThreshold = 80.0 from [0:100];	// Upper threshold for the rise/fall time calculation in percent.%13  10%parameter integer Number = 0 from [0:inf);	// Use the nth rising/falling edge in the calculation. 0 means all edges in the interval.%13  10%parameter real MeasureFrom = 0.0 from [0:inf);	// Unused%13  10%parameter real MeasureTo = 0.0 from [0:inf);		// Unused%13  10  13  10%// Test Parameters%13  10%parameter string TestName = %34  34%;%13  10%parameter integer ID = 1;						// ID used to identify the simulation run.  This is useful for .alter and sweeps.%13  10%parameter string OutputFilename = %34  34%;		// Base Output File name and path without extension. It will create two files OutputFilename_Rise.out and OutputFilename_Fall.out%13  10  13  10%parameter integer Debug = 0 from [0:1];%13  10  13  10%// Variables%13  10%string sTempFileName = %34%TEMP%34%;%13  10%integer nDataFileID = 0;%13  10%integer nRiseOutFileID = 0;%13  10%integer nFallOutFileID = 0;%13  10%string sRiseFileName = %34%Rise%34%;%13  10%string sFallFileName = %34%Fall%34%;%13  10  13  10%real dFinalTime = 0;%13  10  13  10%// Baseline & Topline variables%13  10%real dMax = 0.0;%13  10%real dMin = 0.0;%13  10%integer nNumberOfBins = `NUM_OF_BINS;%13  10%integer nBins[0:`NUM_OF_BINS-1];%13  10%integer nNumRead = 0;%13  10%real dBinSize = 0.0;%13  10%integer nNumberOfSamples = 2000;%13  10%real dSampleSize = 0.0;%13  10%real dPrevX = 0.0;%13  10%real dCurrentX = 0.0;%13  10%real dPrevY = 0.0;%13  10%real dCurrentY = 0.0;%13  10%real dNextSamplePoint = 0.0;%13  10%real dY = 0.0;%13  10%integer i = 0;%13  10%integer nMaxIndex = 0;%13  10%integer nMaxCount = 0;%13  10%real dBaseLine = 0.0;%13  10%real dTopLine = 0.0;%13  10  13  10%// Measurement variables%13  10%real dMidLine = 0.0;%13  10%real dLT = 0.0;%13  10%real dUT = 0.0;%13  10%real dLowerRisingTime = 0.0;%13  10%real dUpperRisingTime = 0.0;%13  10%real dLowerFallingTime = 0.0;%13  10%real dUpperFallingTime = 0.0;%13  10  13  10%analog function real Interpolate;%13  10%input dX0, dX1, dY0, dY1, dXvalue;%13  10%real dX0, dX1, dY0, dY1, dXvalue;%13  10%real dTemp;%13  10% begin%13  10% 	Interpolate = dY0 + ((dXvalue-dX0)*dY1 - (dXvalue-dX0)*dY0)/(dX1-dX0);%13  10% end%13  10%endfunction%13  10  13  10%analog%13  10%begin%13  10%	@(initial_step(%34%tran%34%))%13  10%	 begin%13  10%		$sformat(sTempFileName,%34  37%m_Data.dat%34%);%13  10%		nDataFileID = $fopen(sTempFileName, %34%w%34%);%13  10%		if (nDataFileID == 0)%13  10%		 begin%13  10%			$strobe(%34%WARNING: (%37%d) Cannot open temporary data file \%34  37%s\%34  34%, nDataFileID, sTempFileName);%13  10%		 end%13  10  13  10%		// Make sure you can write to the risetime output file.%13  10%		$sformat(sRiseFileName,%34  37%s_Rise.out%34%, OutputFilename);%13  10%		nRiseOutFileID = $fopen(sRiseFileName, %34%w%34%);%13  10%		if (nRiseOutFileID == 0)%13  10%		 begin%13  10%			$strobe(%34%WARNING: (%37%d) Cannot open risetime output file file \%34  37%s\%34  34%, nRiseOutFileID, sRiseFileName);%13  10%		 end%13  10%		else%13  10%		 $fclose(nRiseOutFileID);%13  10%		nRiseOutFileID = 0;%13  10  13  10%		// Make sure you can write to the falltime output file.%13  10%		$sformat(sFallFileName,%34  37%s_Fall.out%34%, OutputFilename);%13  10%		nFallOutFileID = $fopen(sFallFileName, %34%w%34%);%13  10%		if (nFallOutFileID == 0)%13  10%		 begin%13  10%			$strobe(%34%WARNING: (%37%d) Cannot open risetime output file file \%34  37%s\%34  34%, nFallOutFileID, sFallFileName);%13  10%		 end%13  10%		else%13  10%		 $fclose(nFallOutFileID);%13  10%		nFallOutFileID = 0;%13  10  13  10%	 	dMax = V(NodeToMeasure);%13  10%	 	dMin = V(NodeToMeasure);%13  10%	 end%13  10  13  10%	// Only calculate it during the interval specified.%13  10%	if (($abstime >= StableFrom) && (($abstime <= StableTo) || (StableTo <= 0.0)))%13  10%	 begin%13  10%		// Save the signal for later processing%13  10%		if (nDataFileID != 0)%13  10%			$fstrobe(nDataFileID, %34  37%g %37%g%34%, $abstime, V(NodeToMeasure));%13  10  13  10%		// Calculate the Max and Min.%13  10%		if (V(NodeToMeasure) > dMax)%13  10%			dMax = V(NodeToMeasure);%13  10%		if (V(NodeToMeasure) < dMin)%13  10%			dMin = V(NodeToMeasure);%13  10%		dFinalTime = $abstime;%13  10%	 end%13  10  13  10%	@(final_step(%34%tran%34%))%13  10%	 begin%13  10%	 	// Close the data file%13  10%	 	if (nDataFileID != 0)%13  10%	 	 begin%13  10%	 		$fclose(nDataFileID);%13  10%	 		nDataFileID = 0;%13  10%	 	 end%13  10  13  10%	 	// Calculate the TopLine and BaseLine%13  10%	 	begin%13  10%	 		dBinSize = abs(dMax-dMin)/nNumberOfBins;%13  10%		 	if ( SamplePeriod <= 0 )%13  10%		 	 begin%13  10%		 	 	if ( NumOfSamples <= 0 )%13  10%		 			dSampleSize = abs(dFinalTime - StableFrom)/nNumberOfSamples;%13  10%		 		else%13  10%					dSampleSize = abs(dFinalTime - StableFrom)/NumOfSamples;%13  10%			 end%13  10%			else%13  10%				dSampleSize = SamplePeriod;%13  10  13  10%		 	if ( Debug )%13  10%	 		 begin%13  10%		 		$strobe(%34%Max = %37%g%34%, dMax);%13  10%		 		$strobe(%34%Min = %37%g%34%, dMin);%13  10%		 		$strobe(%34%Bin Size = %37%g%34%, dBinSize);%13  10%		 		$strobe(%34%Sample Size = %37%g%34%, dSampleSize);%13  10%		 	 end%13  10  13  10%			nDataFileID = $fopen(sTempFileName, %34%r%34%);%13  10%			if (nDataFileID != 0)%13  10%			 begin%13  10%			 	// Initialize the bin counts%13  10%			 	for (i = 0; i < `NUM_OF_BINS; i = i +1)%13  10%			 	 begin%13  10%			 	 	nBins[i] = 0;%13  10%			 	 end%13  10  13  10%			 	// Read the data file and sample the signal based on the sampling period.%13  10%			 	nNumRead = 2;%13  10%			 	dNextSamplePoint = StableFrom;%13  10%			 	dPrevX = -1.0;%13  10%			 	dPrevY = 0.0;%13  10%				while (nNumRead == 2)%13  10%				 begin%13  10%			 		nNumRead = $fscanf(nDataFileID, %34  37%f %37%f%34%, dCurrentX, dCurrentY);%13  10%					if (nNumRead == 2)%13  10%					 begin%13  10%					 	// Don't work on the first data point because we need 2 data points for interpolation.%13  10%					 	if ( dPrevX >= 0 )%13  10%					 	 begin%13  10%							if ((dCurrentX >= dNextSamplePoint) && (dPrevX <= dNextSamplePoint))%13  10%					 		 begin%13  10%					 		 	// Found a sample point.  Interpolate the Y value.%13  10%					 			dY = Interpolate(dPrevX, dCurrentX, dPrevY, dCurrentY, dNextSamplePoint);%13  10  13  10%					 			// Calculate which bin the Y value is in and increment that bin.%13  10%					 			i = (dY-dMin)/dBinSize;%13  10%					 			if ( i > 99 )%13  10%					 				i = 99;%13  10%					 			nBins[i] = nBins[i] + 1;%13  10%		 						if ( Debug )%13  10%	 		 					 begin%13  10%									$strobe(%34%Found One = %37%r, %37%r, %37%r, %37%r%34%, dPrevX, dPrevY, dCurrentX, dCurrentY);%13  10%									$strobe(%34%dY = %37%r (%37%d)%34%, dY, i);%13  10%								 end%13  10%								 // Calculate the next sample point.%13  10%					 			dNextSamplePoint = dNextSamplePoint + dSampleSize;%13  10%					 	 	 end%13  10%					 	 end%13  10%					 end%13  10%			 		dPrevX = dCurrentX;%13  10%			 		dPrevY = dCurrentY;%13  10%			 	 end%13  10  13  10%			 	// Calculate the bin with the maximum count in the first half of the bins.%13  10%			 	// This will be the baseline.%13  10%			 	nMaxIndex = 0;%13  10%				nMaxCount = nBins[nMaxIndex];%13  10%			 	for (i = nMaxIndex+1; i < `NUM_OF_BINS / 2; i = i +1)%13  10%			 	 begin%13  10%					if ( nBins[i] > nMaxCount )%13  10%					 begin%13  10%					 	nMaxCount = nBins[i];%13  10%					 	nMaxIndex = i;%13  10%					 end%13  10%			 	 end%13  10%			 	dBaseLine = dMin + (nMaxIndex*dBinSize);%13  10  13  10%			 	// Calculate the bin with the maximum count in the second half of the bins.%13  10%			 	// This will be the topline.%13  10%			 	nMaxIndex = `NUM_OF_BINS / 2;%13  10%				nMaxCount = nBins[nMaxIndex];%13  10%			 	for (i = nMaxIndex+1; i < `NUM_OF_BINS; i = i +1)%13  10%			 	 begin%13  10%					if ( nBins[i] > nMaxCount )%13  10%					 begin%13  10%					 	nMaxCount = nBins[i];%13  10%					 	nMaxIndex = i;%13  10%					 end%13  10%			 	 end%13  10%			 	dTopLine = dMin + (nMaxIndex*dBinSize);%13  10%				if ( Debug )%13  10%	 		 	 begin%13  10%				 	for (i = 0; i < `NUM_OF_BINS; i = i +1)%13  10%				 	 begin%13  10%				 	 	$strobe(%34%Bin %37%d = %37%d%34%, i, nBins[i]);%13  10%				 	 end%13  10%			 		$strobe(%34%Baseline = %37%r%34%, dBaseLine);%13  10%			 		$strobe(%34%Topline = %37%r%34%, dTopLine);%13  10%			 	 end%13  10%			 	// Close the data file%13  10%		 		if (nDataFileID != 0)%13  10%		 	 	 begin%13  10%		 			$fclose(nDataFileID);%13  10%		 			nDataFileID = 0;%13  10%		 	 	 end%13  10%		 	 end%13  10%		 	else%13  10%		 	 begin%13  10%				$strobe(%34%WARNING: (%37%d) Cannot open temporary data file \%34  37%s\%34  34%, nDataFileID, sTempFileName);%13  10%		 	 end%13  10%		end%13  10  13  10%		// Calculate the risetime%13  10%		begin%13  10%			dMidLine = (dTopLine+dBaseLine)/2.0;%13  10%			nDataFileID = $fopen(sTempFileName, %34%r%34%);%13  10%			if (nDataFileID != 0)%13  10%			 begin%13  10%				nRiseOutFileID = $fopen(sRiseFileName, %34%w%34%);%13  10%	 			nFallOutFileID = $fopen(sFallFileName, %34%w%34%);%13  10%				if ((nRiseOutFileID != 0) && (nFallOutFileID != 0))%13  10%			 	 begin%13  10%			 	 	$fstrobe(nRiseOutFileID, %34%ID, Temp, time, RiseTime%34%);%13  10%			 	 	$fstrobe(nFallOutFileID, %34%ID, Temp, time, FallTime%34%);%13  10%				 	dLT = dBaseLine + (dTopLine-dBaseLine)*LowerThreshold/100;%13  10%					dUT = dBaseLine + (dTopLine-dBaseLine)*UpperThreshold/100;%13  10%		 			if ( Debug )%13  10%	 		 		 begin					%13  10%						$strobe(%34%Baseline = %37%r%34%, dBaseLine);%13  10%						$strobe(%34%Topline = %37%r%34%, dTopLine);%13  10%						$strobe(%34%Midline = %37%r%34%, dMidLine);%13  10%						$strobe(%34%Lower Threshold = %37%r%34%, dLT);%13  10%						$strobe(%34%Upper Threshold = %37%r%34%, dUT);%13  10%					 end%13  10%				 	dLowerRisingTime = 0.0;%13  10%					dUpperRisingTime = 0.0;%13  10%				 	dLowerFallingTime = 0.0;%13  10%					dUpperFallingTime = 0.0;%13  10%				 	// Read the data file%13  10%				 	nNumRead = 2;%13  10%				 	dPrevX = -1.0;%13  10%				 	dPrevY = 0.0;%13  10%				 	i = 1;%13  10%					while (nNumRead == 2)%13  10%					 begin%13  10%				 		nNumRead = $fscanf(nDataFileID, %34  37%f %37%f%34%, dCurrentX, dCurrentY);%13  10%						if (nNumRead == 2)%13  10%						 begin%13  10%							// Don't work on the first data point because we need 2 data points to check for rising/falling.%13  10%						 	if ( dPrevX > 0 )%13  10%						 	 begin%13  10%						 	 	// Check for rising edge%13  10%						 	 	if ((dPrevY < dLT) && (dCurrentY > dLT))%13  10%						 	 	 begin%13  10%						 	 		dLowerRisingTime =  Interpolate(dPrevY, dCurrentY, dPrevX, dCurrentX, dLT);%13  10%		 							if ( Debug )%13  10%	 		 						 begin						 	 		%13  10%						 	 			$strobe(%34%Lower Rising Time = %37%r%34%, dLowerRisingTime);%13  10%						 	 		 end%13  10%						 	 	 end%13  10%						 	 	if ((dPrevY < dUT) && (dCurrentY > dUT))%13  10%						 	 	 begin%13  10%						 	 		dUpperRisingTime =  Interpolate(dPrevY, dCurrentY, dPrevX, dCurrentX, dUT);%13  10%		 							if ( Debug )%13  10%	 		 						 begin						 	 		%13  10%						 	 			$strobe(%34%Upper Rising Time = %37%r%34%, dUpperRisingTime);%13  10%						 	 			$strobe(%34%Rise Time = %37%r%34%, dUpperRisingTime-dLowerRisingTime);%13  10%						 	 		 end%13  10%						 	 		if ((Number == 0) || (i == Number))%13  10%						 	 			$fstrobe(nRiseOutFileID, %34  37%d, %37%r, %37%r, %37%r%34%, ID, $temperature, dLowerRisingTime, (dUpperRisingTime-dLowerRisingTime));%13  10%						 	 	 end%13  10%						 	 	// Check for falling edge%13  10%						 	 	if ((dPrevY > dLT) && (dCurrentY < dLT))%13  10%						 	 	 begin%13  10%						 	 		dLowerFallingTime =  Interpolate(dPrevY, dCurrentY, dPrevX, dCurrentX, dLT);%13  10%		 							if ( Debug )%13  10%	 		 						 begin						 	 								 	 		%13  10%										$strobe(%34%Lower Falling Time = %37%r%34%, dLowerFallingTime);%13  10%										$strobe(%34%Fall Time = %37%r%34%, dLowerFallingTime-dUpperFallingTime);%13  10%									 end%13  10%						 	 		if ((Number == 0) || (i == Number))%13  10%						 	 			$fstrobe(nFallOutFileID, %34  37%d, %37%r, %37%r, %37%r%34%, ID, $temperature, dUpperFallingTime, (dLowerFallingTime-dUpperFallingTime));%13  10%						 	 	 end%13  10%						 	 	if ((dPrevY > dUT) && (dCurrentY < dUT))%13  10%						 	 	 begin%13  10%						 	 		dUpperFallingTime =  Interpolate(dPrevY, dCurrentY, dPrevX, dCurrentX, dUT);%13  10%		 							if ( Debug )%13  10%	 		 						 begin						 	 								 	 		%13  10%						 	 			$strobe(%34%Upper Falling Time = %37%r%34%, dUpperFallingTime);%13  10%						 	 		 end%13  10%						 	 	 end%13  10%						 	 end%13  10%						 end%13  10%				 		dPrevX = dCurrentX;%13  10%				 		dPrevY = dCurrentY;%13  10%					 end%13  10  13  10%					$fclose(nRiseOutFileID);%13  10%	 				nRiseOutFileID = 0;%13  10%	 				$fclose(nFallOutFileID);%13  10%	 				nFallOutFileID = 0;%13  10%				 end%13  10%	 			$fclose(nDataFileID);%13  10%	 			nDataFileID = 0;%13  10%	 	 	 end%13  10%		end%13  10%	 end%13  10%end%13  10%// Module contents%13  10  13  10%endmodule // TRAN_Measure_Dynamic_Risetime%13  10%")
				)
			)
		)
