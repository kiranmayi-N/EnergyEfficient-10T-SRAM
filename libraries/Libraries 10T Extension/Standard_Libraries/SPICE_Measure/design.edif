			(view
				(rename Main_0 "Main")
				(viewType STRANGER)
				(interface
					(property Corner
						(number 0)
						(comment "Simulation corner")
					)
					(property QA_ResultFilename
						(number 0)
						(comment "QA Results filename without extension.  Can include path.")
					)
					(property QA_ValidationDataFilename
						(number 0)
						(comment "QA Validation data filename with path.")
					)
					(property
						(rename SPICE_PERIOD_OUTPUT "SPICE.OUTPUT")
						(string "X${Name} %37  37% ${cell} $$")
					)
					(property
						(rename SPICE_PERIOD_PARAMETERS "SPICE.PARAMETERS")
						(string "TestName\=STR(\%34%TestName$\%34%) TranW~ Corner~ Tolerance~ QA_ValidationDataFilename\=STR(\%34%QA_ValidationDataFilename$\%34%) QA_ResultFilename\=STR(\%34%QA_ResultFilename$\%34%) ")
						(property InterfaceParameter
							(boolean
								(false)
							)
						)
					)
					(property
						(rename SPICE_PERIOD_PINORDER "SPICE.PINORDER")
						(string "Vd Vds Vgs")
						(property InterfaceParameter
							(boolean
								(false)
							)
						)
						(property Type
							(string "String")
						)
					)
					(property TestName
						(number 0)
					)
					(property Tolerance
						(number 5)
						(comment "Percent tolerance indicating a failed validation.")
					)
					(property TranL
						(number 0)
					)
					(property TranW
						(number 0)
						(comment "Transistor width")
					)
					(property TannerStandard
						(boolean
							(true)
						)
						(property Timestamp
							(string "2013 01 15 18 34 59")
						)
						(property RevisionCount
							(string "34")
						)
					)
				)
				(property Type
					(string "Verilog-A")
				)
				(property text
					(string "%13  10%`include %34%constants.h%34%			// Include Files%13  10%`include %34%discipline.h%34  13  10  13  10%`define F_EOF -1%13  10%`define DF_TOLERANCE 1E-4%13  10  13  10%module DC_Measure_IDsat(Vd, Vds, Vgs);%13  10%input Vd;%13  10%inout Vgs;%13  10%inout Vds;%13  10%electrical Vd, Vds, Vgs;%13  10  13  10%branch(Vds, Vd) IDS_Branch;%13  10  13  10%parameter real TranW = 0;%13  10%parameter real TranL = 0;%13  10%parameter integer Corner = 0;%13  10  13  10%parameter real Tolerance = 5;%13  10%parameter string QA_ValidationDataFilename = %34  34%;%13  10%parameter string QA_ResultFilename = %34  34%;%13  10%parameter string TestName = %34%Test%34%;%13  10  13  10%integer nValidationDataFileID = 0;%13  10%integer nLogFileID = 0;%13  10%integer nErrorFileID = 0;%13  10%real dTemp = 0;%13  10  13  10%string sLogName = %34%TEMP%34%;%13  10%string sErrName = %34%TEMP%34%;%13  10  13  10  13  10%integer bFound = 0;%13  10%integer nLineNum=0;%13  10%integer nNumRead = 0;%13  10%integer nTempNumRead = 0;%13  10%real dFileVds = 0.0;%13  10%real dFileVgs = 0.0;%13  10%real dFileTranW = 0.0;%13  10%real dFileTranL = 0.0;%13  10%real dFileTemp = 0.0;%13  10%integer nFileCorner = 0;%13  10%integer nFileTestType = 0;%13  10  13  10%real dValue = 0.0;%13  10%real dDifference = 0.0;%13  10%string sResult = %34%FAILED%34%;%13  10%integer i = 0;%13  10  13  10%analog function integer SameValues;%13  10%input dExpectedValue, dValue; %13  10%real dExpectedValue, dValue; %13  10%real dTemp;%13  10% begin%13  10% 	dTemp = abs(dExpectedValue-dValue);%13  10% 	if (dTemp != 0.0)%13  10% 		dTemp = abs(dTemp / dValue);%13  10% 	SameValues = (dTemp < `DF_TOLERANCE);%13  10% end%13  10%endfunction%13  10  13  10%analog%13  10%begin %13  10%	@(final_step(%34%dc%34%))%13  10%	 begin %13  10%	 	// Get temperature%13  10%	 	dTemp = $temperature-273.15;%13  10%		// Open log and error files.%13  10%		$sformat(sErrName,%34  37%s.log%34%, QA_LogFilename);%13  10%		nLogFileID = $fopen(sLogName, %34%a%34%);%13  10%		if (nLogFileID != 0)%13  10%		 begin%13  10%		 	$sformat(sLogName,%34  37%s.err%34%, QA_LogFilename);%13  10%			nErrorFileID = $fopen(sErrName, %34%a%34%);%13  10%			if (nErrorFileID != 0)%13  10%			begin %13  10%				// Get the published result.%13  10%				begin %13  10%					nValidationDataFileID = $fopen(QA_ValidationDataFilename, %34%r%34%);%13  10%					if (nValidationDataFileID != 0)%13  10%					 begin %13  10%					 	bFound = 0;%13  10%					 	nLineNum = 0;%13  10%					 	dValue = 0.0;%13  10%					 	nNumRead = 8;%13  10%						while (nNumRead == 8)%13  10%						 begin%13  10%							nNumRead = $fscanf(nValidationDataFileID, %34  37%f,%37%f,%37%f,%37%f,%37%f,%37%d,%37%d,%37%f%34%, %13  10%															dFileVds, dFileVgs, dFileTranW, dFileTranL, dFileTemp,%13  10%															nFileCorner, nFileTestType, dValue);%13  10%							nLineNum = nLineNum + 1;%13  10%							if (nNumRead == 8)%13  10%							 begin %13  10%								if (SameValues(dFileVds,Vds) && SameValues(dFileVgs, Vgs) && %13  10%									 SameValues(dFileTranW, TranW) && SameValues(dFileTranL,TranL) &&%13  10%									 SameValues(dFileTemp, dTemp) && %13  10%									 (nFileCorner == Corner) && (nFileTestType == TestType))%13  10%								 begin %13  10%									bFound = 1;%13  10%									nNumRead = 0;%13  10%								 end %13  10%							 end %13  10%							else if (nNumRead != 8)%13  10%							 begin %13  10%								// Send warning to log						%13  10%								$strobe(%34%WARNING: Line found without enough data (%37%d) on line %37%d in file \%34  37%s\%34  34%, nNumRead, nLineNum, QA_ValidationDataFilename);%13  10%							 end  %13  10%						 end %13  10%						$fclose(nValidationDataFileID);%13  10%					 end %13  10%					else%13  10%					 begin %13  10%						$strobe(%34%WARNING: Cannot open validation data file \%34  37%s\%34  34%, QA_ValidationDataFilename);%13  10%					 end%13  10%			 	end %13  10%				if ( bFound != 0)%13  10%				 begin %13  10%					// Calculate the Difference as a percentage.%13  10%					dDifference = dValue-I(IDS_Branch);%13  10%					if (dValue != 0.0)%13  10%						dDifference = dDifference / dValue;%13  10%					dDifference = abs(dDifference * 100);		%13  10%			%13  10%					// Compare to the tolerance.%13  10%					if (dDifference > Tolerance)%13  10%					 begin %13  10%						sResult = %34%FAILED%34%;%13  10%					 	$strobe(%34  37%s - %37%s Test: ID=%37%r\tExpected Value=%37%r\tDifference=%37%8.4f%37  37%\tTranW=%37%r\tTranL=%37%r\tVds=%37%r\tVgs=%37%r\tCorner=%37%d\tTemp=%37%3.0f%34%, sResult, TestName, I(IDS_Branch), dValue, dDifference, TranW, TranL, Vds, Vgs, Corner, dTemp);%13  10%				 		$fstrobe(nErrorFileID, %34  37%s - %37%s Test: ID=%37%r\tExpected Value=%37%r\tDifference=%37%8.4f%37  37%\tTranW=%37%r\tTranL=%37%r\tVds=%37%r\tVgs=%37%r\tCorner=%37%d\tTemp=%37%3.0f%34%, sResult, TestName, I(IDS_Branch), dValue, dDifference, TranW, TranL, Vds, Vgs, Corner, dTemp);%13  10%					 end %13  10%					else%13  10%					 	sResult = %34%PASSED%34%;%13  10%			%13  10%				 	$fstrobe(nLogFileID, %34  37%s - %37%s Test: ID=%37%r\tExpected Value=%37%r\tDifference=%37%8.4f%37  37%\tTranW=%37%r\tTranL=%37%r\tVds=%37%r\tVgs=%37%r\tCorner=%37%d\tTemp=%37%3.0f%34%, sResult, TestName, I(IDS_Branch), dValue, dDifference, TranW, TranL, Vds, Vgs, Corner, dTemp);%13  10%				 end %13  10%				else%13  10%				 begin %13  10%					// Send warning to log						%13  10%					$strobe(%34%WARNING: Cannot find validation data for the following in file \%34  37%s\%34%\n\tTranW=%37%r\tTranL=%37%r\tVds=%37%r\tVgs=%37%r\tCorner=%37%d\tTemp=%37%3.0f\tTest=IDSAT%34%, QA_ValidationDataFilename, TranW, TranL, Vds, Vgs, Corner, dTemp);%13  10%				 end %13  10%				$fclose(nErrorFileID);%13  10%			 end %13  10%			else%13  10%			 begin %13  10%				$strobe(%34%WARNING: Cannot open QA Error log file \%34  37%s\%34  34%, QA_ErrorLogFilename);%13  10%			 end %13  10%			$fclose(nLogFileID);%13  10%		 end %13  10%		else%13  10%		 begin %13  10%			$strobe(%34%WARNING: (%37%d) Cannot open QA main log file \%34  37%s\%34  34%, nLogFileID, QA_LogFilename);%13  10%		 end %13  10%	end %13  10%end %13  10%endmodule%13  10%")
				)
			)
		)
