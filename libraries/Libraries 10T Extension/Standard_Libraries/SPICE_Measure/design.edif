					(property
						(rename SPICE_PERIOD_OUTPUT "SPICE.OUTPUT")
						(string ".MEASURE TRAN RiseDelay_${Name} TRIG v(%37%{Vin}) VAL='${Calc.StartVoltage}' TD='${Delay}' RISE=1 TARG v(%37%{Vout}) VAL='${Calc.EndVoltage}' TD='${Delay}' FALL=1 OFF\n.MEASURE TRAN FallDelay_${Name} TRIG v(%37%{Vin}) VAL='${Calc.StartVoltage}' TD='${Delay}' FALL=1 TARG v(%37%{Vout}) VAL='${Calc.EndVoltage}' TD='${Delay}' RISE=1 OFF\n.MEASURE TRAN ${MeasureName} PARAM='(RiseDelay_${Name}+FallDelay_${Name})/2.0' ${PrintMeasure}")
