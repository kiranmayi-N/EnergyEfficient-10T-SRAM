		(cell Capacitor_MiM
			(cellType GENERIC)
			(view VCapacitor
				(viewType SCHEMATIC)
				(interface
					(port Bottom)
					(port Top)
					(property
						(rename ANNOTATE_PERIOD_Bottom "ANNOTATE.Bottom")
						(string "[FormatAnnotation [ annotate port Bottom ]]")
						(property InterfaceParameter
							(boolean
								(false)
							)
						)
					)
					(property
						(rename ANNOTATE_PERIOD_Top "ANNOTATE.Top")
						(string "[FormatAnnotation [ annotate port Top ]]")
						(property InterfaceParameter
							(boolean
								(false)
							)
						)
					)
					(property AspectRatio
						(number 1)
						(property InterfaceParameter
							(boolean
								(false)
							)
						)
						(comment "Aspect ratio for the capacitor when calculating L & W from C. Set it to 0.0 to ignore it when calculating the capacitor's parameters from C.")
					)
					(property C
						(string "89.71fF")
						(property Callback
							(string "::TannerPDK::ValidateDevice %34%C%34%")
						)
						(property Type
							(string "Double")
						)
						(comment "Capacitance.")
					)
					(property L
						(string "10.0u")
						(property Callback
							(string "::TannerPDK::ValidateDevice %34%L%34%")
						)
						(property Type
							(string "Double")
						)
						(comment "Length of capacitor.")
					)
					(property
						(rename LVS_PERIOD_OUTPUT "LVS.OUTPUT")
						(string "X${Name} %37  37% ${Model} $$")
						(property InterfaceParameter
							(boolean
								(false)
							)
						)
					)
					(property
						(rename LVS_PERIOD_PARAMETERS "LVS.PARAMETERS")
						(string "L= W= M~ \$ C=")
						(property InterfaceParameter
							(boolean
								(false)
							)
						)
					)
					(property
						(rename LVS_PERIOD_PINORDER "LVS.PINORDER")
						(string "Top Bottom")
						(property InterfaceParameter
							(boolean
								(false)
							)
						)
					)
					(property M
						(integer 1)
						(property Callback
							(string "::TannerPDK::ValidateDevice %34%M%34%")
						)
						(comment "Multiplicity - the number of devices to be placed in parallel.")
					)
					(property Model
						(string "Capacitor_MIM")
						(property InterfaceParameter
							(boolean
								(false)
							)
						)
						(property Callback
							(string "CalcProperty Model")
						)
						(comment "Capacitor model name.")
					)
					(property Rand
						(number 0)
						(property InterfaceParameter
							(boolean
								(false)
							)
						)
						(comment "Random number for Monte Carlo simulations. AGAUSS(0,1,1)")
					)
					(property
						(rename SDL_PERIOD_DEFINITION "SDL.DEFINITION")
						(string ".SUBCKT ${Cell} ${SDL.PINORDER}")
						(property InterfaceParameter
							(boolean
								(false)
							)
						)
					)
					(property
						(rename SDL_PERIOD_OUTPUT "SDL.OUTPUT")
						(string "X${Name} %37  37% ${Cell} $$")
						(property InterfaceParameter
