DEVICE X(NMOS_DEEP) "ntran Deep" ndiff(Drain) PolyWire(Gate) ndiff(Source) "P Well"(Bulk) "Deep N Well Wire"(IsolationBulk)
	BY SHAPE
[
	property L, W, AREA_Drain, PERI_Drain, AREA_Source, PERI_Source
lp=perimeter("ntran Deep")
la=area("ntran Deep")
L=(lp+sqrt(lp*lp-16*la))/4
W=(lp-sqrt(lp*lp-16*la))/4
na=1
AREA_Drain=area(Drain)/na
PERI_Drain=perimeter(Drain)
AREA_Source=area(Source)/na
PERI_Source=perimeter(Source)

]
