						(property Type
							(string "Double")
						)
						(comment "Area of the Source.")
					)
					(property
						(rename Calc_PERIOD_DrainFingerLength "Calc.DrainFingerLength")
						(string "if(${Calc.Odd}, ${Calc.OddDA2}, ${Calc.EvenDA2})")
						(property Type
							(string "Double")
						)
					)
					(property
						(rename Calc_PERIOD_DrainFingerPc "Calc.DrainFingerPc")
						(string "if(${Calc.Odd}, 2*${Calc.OddDA1}/${Calc.NF}, 2*${Calc.EvenDA2})")
						(property Type
							(string "Double")
						)
					)
					(property
						(rename Calc_PERIOD_DrainFingerPv "Calc.DrainFingerPv")
						(string "if(${Calc.Odd},${Calc.InvNF},2*${Calc.InvNF})+${GatePerimeterFactor}")
						(property Type
							(string "Double")
						)
					)
					(property
						(rename Calc_PERIOD_EvenDA1 "Calc.EvenDA1")
						(string "2*${Tech.OuterLength}+${Calc.M1}*${Tech.InnerLength}")
						(property Type
							(string "Double")
						)
					)
					(property
						(rename Calc_PERIOD_EvenDA2 "Calc.EvenDA2")
						(string "${Calc.EvenDA1}/${Calc.NF}")
						(property Type
							(string "Double")
						)
					)
					(property
						(rename Calc_PERIOD_InvNF "Calc.InvNF")
						(string "1/${Calc.NF}")
						(property Type
							(string "Double")
						)
					)
					(property
						(rename Calc_PERIOD_M1 "Calc.M1")
						(string "floor((${Calc.NF}-1)/2)")
						(property Type
							(string "Double")
						)
					)
					(property
						(rename Calc_PERIOD_M2 "Calc.M2")
						(string "floor(${Calc.NF}/2)")
						(property Type
							(string "Double")
						)
					)
					(property
						(rename Calc_PERIOD_NF "Calc.NF")
						(string "if([property get UseNF -evaluated],${NF}*${M},${M})")
						(property InterfaceParameter
							(boolean
								(false)
							)
						)
						(property Type
							(string "Double")
						)
					)
					(property
						(rename Calc_PERIOD_Odd "Calc.Odd")
						(string "fmod(${Calc.NF},2)")
						(property InterfaceParameter
							(boolean
								(false)
							)
						)
						(property Type
							(string "Double")
						)
					)
					(property
						(rename Calc_PERIOD_OddDA1 "Calc.OddDA1")
						(string "${Tech.OuterLength}+(${Calc.M2}*${Tech.InnerLength})")
						(property Type
							(string "Double")
						)
					)
					(property
						(rename Calc_PERIOD_OddDA2 "Calc.OddDA2")
						(string "${Calc.OddDA1}/${Calc.NF}")
						(property Type
							(string "Double")
						)
					)
					(property
						(rename Calc_PERIOD_SourceFingerLength "Calc.SourceFingerLength")
						(string "if(${Calc.Odd}, ${Calc.OddDA2}, ${Tech.InnerLength}/2)")
						(property Type
							(string "Double")
						)
					)
					(property
						(rename Calc_PERIOD_SourceFingerPc "Calc.SourceFingerPc")
						(string "if(${Calc.Odd}, ${Calc.DrainFingerPc}, ${Tech.InnerLength})")
						(property Type
							(string "Double")
						)
					)
					(property
						(rename Calc_PERIOD_SourceFingerPv "Calc.SourceFingerPv")
						(string "if(${Calc.Odd}, ${Calc.DrainFingerPv}, ${GatePerimeterFactor})")
						(property Type
							(string "Double")
						)
					)
					(property
						(rename Calc_PERIOD_W "Calc.W")
						(string "${Calc.WFactor}*${W}")
						(property Type
							(string "Double")
						)
					)
					(property
						(rename Calc_PERIOD_WFactor "Calc.WFactor")
						(string "if([property get UseNF -evaluated], ${Calc.InvNF}, 1)")
						(property Type
							(string "Double")
						)
					)
					(property GEO
						(string "")
						(property ValidValues
							(string "0 1 2 3 [ ]")
						)
						(comment "Selector for source/drain sharing of stacked devices. GEO = 0, 1, 2, or 3.")
					)
					(property GatePerimeterFactor
						(number 1)
						(property InterfaceParameter
							(boolean
								(false)
							)
						)
						(comment "Percentage of the gate width that should be included in the perimeter of the source and drain (0.0 <= x <= 1.0). 0 - None, 1 - All the gate width.")
					)
