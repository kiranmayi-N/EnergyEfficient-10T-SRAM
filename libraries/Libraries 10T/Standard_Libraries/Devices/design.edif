			(view PMOS4
				(viewType SCHEMATIC)
				(interface
					(port B)
					(port D)
					(port G
						(direction INPUT)
					)
					(port S)
					(property AD
						(string "${Calc.DrainFingerLength}*${Calc.W}")
						(property Callback
							(string "CalcProperty AD")
						)
						(property Type
							(string "Double")
						)
						(comment "Area of the Drain.")
					)
					(property
						(rename ANNOTATE_PERIOD_Bulk "ANNOTATE.Bulk")
						(string "[ annotate port B ]")
						(property InterfaceParameter
							(boolean
								(false)
							)
						)
					)
					(property
						(rename ANNOTATE_PERIOD_Drain "ANNOTATE.Drain")
						(string "[ annotate port D ]")
						(property InterfaceParameter
							(boolean
								(false)
							)
						)
					)
					(property
						(rename ANNOTATE_PERIOD_Gate "ANNOTATE.Gate")
						(string "[ annotate port G ]")
						(property InterfaceParameter
							(boolean
								(false)
							)
						)
					)
					(property
						(rename ANNOTATE_PERIOD_Source "ANNOTATE.Source")
						(string "[ annotate port S ]")
						(property InterfaceParameter
							(boolean
								(false)
							)
						)
					)
					(property AS
						(string "${Calc.SourceFingerLength}*${Calc.W}")
						(property Callback
							(string "CalcProperty AS")
						)
						(property Type
							(string "Double")
						)
						(comment "Area of the Source.")
					)
					(property
						(rename Calc_PERIOD_DrainFingerLength "Calc.DrainFingerLength")
						(string "if(${Calc.Odd}, ${Calc.OddDA2}, ${Calc.EvenDA2})")
						(property Type
							(string "Double")
						)
					)
					(property
						(rename Calc_PERIOD_DrainFingerPc "Calc.DrainFingerPc")
						(string "if(${Calc.Odd}, 2*${Calc.OddDA1}/${Calc.NF}, 2*${Calc.EvenDA2})")
						(property Type
							(string "Double")
						)
					)
					(property
						(rename Calc_PERIOD_DrainFingerPv "Calc.DrainFingerPv")
						(string "if(${Calc.Odd},${Calc.InvNF},2*${Calc.InvNF})+${GatePerimeterFactor}")
						(property Type
							(string "Double")
						)
					)
					(property
						(rename Calc_PERIOD_EvenDA1 "Calc.EvenDA1")
						(string "2*${Tech.OuterLength}+${Calc.M1}*${Tech.InnerLength}")
						(property Type
							(string "Double")
						)
					)
					(property
						(rename Calc_PERIOD_EvenDA2 "Calc.EvenDA2")
						(string "${Calc.EvenDA1}/${Calc.NF}")
						(property Type
							(string "Double")
						)
					)
					(property
						(rename Calc_PERIOD_InvNF "Calc.InvNF")
						(string "1/${Calc.NF}")
						(property Type
							(string "Double")
						)
					)
					(property
						(rename Calc_PERIOD_M1 "Calc.M1")
						(string "floor((${Calc.NF}-1)/2)")
						(property Type
							(string "Double")
						)
					)
					(property
						(rename Calc_PERIOD_M2 "Calc.M2")
						(string "floor(${Calc.NF}/2)")
						(property Type
							(string "Double")
						)
					)
					(property
						(rename Calc_PERIOD_NF "Calc.NF")
						(string "if([property get UseNF -evaluated],${NF}*${M},${M})")
						(property InterfaceParameter
							(boolean
								(false)
							)
						)
						(property Type
							(string "Double")
						)
					)
					(property
						(rename Calc_PERIOD_Odd "Calc.Odd")
						(string "fmod(${Calc.NF},2)")
						(property InterfaceParameter
							(boolean
								(false)
							)
						)
						(property Type
							(string "Double")
						)
					)
					(property
						(rename Calc_PERIOD_OddDA1 "Calc.OddDA1")
						(string "${Tech.OuterLength}+(${Calc.M2}*${Tech.InnerLength})")
						(property Type
							(string "Double")
						)
					)
					(property
						(rename Calc_PERIOD_OddDA2 "Calc.OddDA2")
						(string "${Calc.OddDA1}/${Calc.NF}")
						(property Type
							(string "Double")
						)
					)
					(property
						(rename Calc_PERIOD_SourceFingerLength "Calc.SourceFingerLength")
						(string "if(${Calc.Odd}, ${Calc.OddDA2}, ${Tech.InnerLength}/2)")
						(property Type
							(string "Double")
						)
					)
					(property
						(rename Calc_PERIOD_SourceFingerPc "Calc.SourceFingerPc")
						(string "if(${Calc.Odd}, ${Calc.DrainFingerPc}, ${Tech.InnerLength})")
						(property Type
							(string "Double")
						)
					)
					(property
						(rename Calc_PERIOD_SourceFingerPv "Calc.SourceFingerPv")
						(string "if(${Calc.Odd}, ${Calc.DrainFingerPv}, ${GatePerimeterFactor})")
						(property Type
							(string "Double")
						)
					)
					(property
						(rename Calc_PERIOD_W "Calc.W")
						(string "${Calc.WFactor}*${W}")
						(property Type
							(string "Double")
						)
					)
					(property
						(rename Calc_PERIOD_WFactor "Calc.WFactor")
						(string "if([property get UseNF -evaluated], ${Calc.InvNF}, 1)")
						(property Type
							(string "Double")
						)
					)
					(property GEO
						(string "")
						(property ValidValues
							(string "0 1 2 3 [ ]")
						)
						(comment "Selector for source/drain sharing of stacked devices. GEO = 0, 1, 2, or 3.")
					)
					(property GatePerimeterFactor
						(number 1)
						(property InterfaceParameter
							(boolean
								(false)
							)
						)
						(comment "Percentage of the gate width that should be included in the perimeter of the source and drain (0.0 <= x <= 1.0). 0 - None, 1 - All the gate width.")
					)
					(property L
						(string "0.25u")
						(property Type
							(string "Double")
						)
						(comment "Channel length of the MOSFET.")
					)
					(property M
						(integer 1)
						(comment "Number of Fingers. Multiplicity%8212%the number of devices to be placed in parallel.")
					)
					(property Model
						(string "PMOS")
						(comment "MOSFET model name.")
					)
					(property NF
						(integer 1)
						(property InterfaceParameter
							(boolean
								(false)
							)
						)
						(comment "Number of Fingers. ")
					)
					(property NRD
						(number 0)
						(comment "Number of squares of diffusion%8212%drain.")
					)
					(property NRS
						(number 0)
						(comment "Number of squares of diffusion%8212%source.")
					)
					(property PD
						(string "${Calc.DrainFingerPc}+${Calc.DrainFingerPv}*${Calc.W}")
						(property Callback
							(string "CalcProperty PD")
						)
						(property Type
							(string "Double")
						)
						(comment "Perimeter of the Drain.")
					)
					(property PS
						(string "${Calc.SourceFingerPc}+${Calc.SourceFingerPv}*${Calc.W}")
						(property Callback
							(string "CalcProperty PS")
						)
						(property Type
							(string "Double")
						)
						(comment "Perimeter of the Source.")
					)
					(property RDC
						(number 0)
						(comment "Additional contact resistance, which overrides the rdc model parameter value%8212%drain.")
					)
					(property RSC
						(number 0)
						(comment "Additional contact resistance, which overrides the rsc model parameter value%8212%source.")
					)
					(property RSH
						(number 0)
						(comment "Source-Drain sheet resistance, which overrides the rsh model parameter.")
					)
					(property
						(rename SPICE_PERIOD_MODEL "SPICE.MODEL")
						(string "$Model")
						(property InterfaceParameter
							(boolean
								(false)
							)
						)
					)
					(property
						(rename SPICE_PERIOD_ORDER "SPICE.ORDER")
						(integer 30)
						(property InterfaceParameter
							(boolean
								(false)
							)
						)
					)
					(property
						(rename SPICE_PERIOD_PARAMETERS "SPICE.PARAMETERS")
						(string "W= L= M~ AS= PS= AD= PD= NRD~ NRS~ RDC~ RSC~ RSH~ GEO~")
						(property InterfaceParameter
							(boolean
								(false)
							)
						)
					)
					(property
						(rename SPICE_PERIOD_PINORDER "SPICE.PINORDER")
						(string "D G S B")
						(property InterfaceParameter
							(boolean
								(false)
							)
						)
					)
					(property
						(rename SPICE_PERIOD_PREFIX "SPICE.PREFIX")
						(string "M")
						(property InterfaceParameter
							(boolean
								(false)
							)
						)
					)
					(property
						(rename SPICE_PERIOD_PRIMITIVE "SPICE.PRIMITIVE")
						(boolean (true))
						(property InterfaceParameter
							(boolean
								(false)
							)
						)
					)
					(property TW
						(string "${W}*${M}")
						(property InterfaceParameter
							(boolean
								(false)
							)
						)
						(property Callback
							(string "ReadOnlyProperty TW")
						)
						(property Type
							(string "Double")
						)
						(comment "Total width of the MOSFET. TW=W*M")
					)
					(property
						(rename Tech_PERIOD_InnerLength "Tech.InnerLength")
						(string "1.25u")
						(property Type
							(string "Double")
						)
					)
					(property
						(rename Tech_PERIOD_OuterLength "Tech.OuterLength")
						(string "0.90u")
						(property Type
							(string "Double")
						)
					)
					(property UseNF
