			(view Pulse
				(viewType SCHEMATIC)
				(interface
					(port Neg)
					(port Pos)
					(property
						(rename ANNOTATE_PERIOD_Neg "ANNOTATE.Neg")
						(string "[FormatAnnotation [ annotate port Neg ]]")
						(property InterfaceParameter
							(boolean
								(false)
							)
						)
					)
					(property
						(rename ANNOTATE_PERIOD_Pos "ANNOTATE.Pos")
						(string "[FormatAnnotation [ annotate port Pos ]]")
						(property InterfaceParameter
							(boolean
								(false)
							)
						)
					)
					(property
						(rename BDA_PERIOD_PARAMETERS "BDA.PARAMETERS")
						(string "PULSE(VLow$ VHigh$ Delay$ RiseTime$ FallTime$ PulseWidth$ Period$)")
						(property InterfaceParameter
							(boolean
								(false)
							)
						)
					)
					(property Delay
						(string "0ns")
						(property Type
							(string "Double")
						)
						(comment "Delay time before the pattern. Initial delay.")
					)
					(property FallTime
						(string "5ns")
						(property Type
							(string "Double")
						)
					)
					(property Freq
						(string "1.0/${Period}")
						(property InterfaceParameter
							(boolean
								(false)
							)
						)
						(property Type
							(string "Double")
						)
					)
					(property Period
						(string "200ns")
						(property Type
							(string "Double")
						)
					)
					(property PulseWidth
						(string "'(${Period}-${FallTime}-${RiseTime})/2.0'")
						(property Type
							(string "Double")
						)
						(comment "Pulse width of the signal not including the risetime or falltime.")
					)
					(property ROUND
						(number 0)
						(comment "Rounding half-interval. A corner at time T is replaced by a smoothly differentiable polynomial in the interval (T%8211%RND,T+RND). The maximum RND is half the distance to the nearest neighboring corner.")
					)
					(property RiseTime
						(string "5ns")
						(property Type
							(string "Double")
						)
						(comment "Rise time.")
