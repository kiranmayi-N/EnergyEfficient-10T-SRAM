				(property Type
					(string "Verilog-A")
				)
				(property text
					(string "%13  10%`include %34%constants.h%34%			// Include Files%13  10%`include %34%discipline.h%34  13  10  13  10%module NoiseVoltageSource(in, out);%13  10%inout in, out;%13  10%electrical in, out;%13  10  13  10%parameter integer NoiseTypeI = 1 from [1:7];	%13  10%parameter real Mean = 0.05 from (0:inf);	%13  10%parameter real KStage = 1.0 from (0:inf);%13  10%parameter real NoiseFreq = 1E6 from (0:inf);%13  10%parameter integer NoiseOnAtFreq = 0 from [0:1];%13  10  13  10%integer MySeed = 0;%13  10%real vRandom = 0;%13  10  13  10%analog%13  10% begin%13  10  13  10%	if(NoiseOnAtFreq==1)%13  10%	 begin%13  10%		if (NoiseTypeI == 1)%13  10%			vRandom = $rdist_uniform(MySeed, -Mean, Mean);%13  10%		else if(NoiseTypeI == 2)%13  10%			vRandom = $rdist_normal(MySeed, 0, Mean);%13  10%		else if(NoiseTypeI == 3)%13  10%			vRandom = $rdist_exponential(MySeed, Mean);%13  10%		else if(NoiseTypeI == 4)%13  10%			vRandom = $rdist_poisson(MySeed, Mean);%13  10%		else if(NoiseTypeI == 5)%13  10%			vRandom = $rdist_chi_square(MySeed, Mean);%13  10%		else if(NoiseTypeI == 6)%13  10%			vRandom = $rdist_t(MySeed, Mean);%13  10%		else if(NoiseTypeI == 7)%13  10%			vRandom = $rdist_erlang(MySeed, KStage, Mean);%13  10%		else%13  10%			vRandom = 0;%13  10%	 end%13  10%	else%13  10%		vRandom = 0;%13  10%	%13  10%	@(timer(0, 0.01/NoiseFreq))%13  10%	 begin%13  10%		if (NoiseTypeI == 1)%13  10%			vRandom = $rdist_uniform(MySeed, -Mean, Mean);%13  10%		else if(NoiseTypeI == 2)%13  10%			vRandom = $rdist_normal(MySeed, 0, Mean);%13  10%		else if(NoiseTypeI == 3)%13  10%			vRandom = $rdist_exponential(MySeed, Mean);%13  10%		else if(NoiseTypeI == 4)%13  10%			vRandom = $rdist_poisson(MySeed, Mean);%13  10%		else if(NoiseTypeI == 5)%13  10%			vRandom = $rdist_chi_square(MySeed, Mean);%13  10%		else if(NoiseTypeI == 6)%13  10%			vRandom = $rdist_t(MySeed, Mean);%13  10%		else if(NoiseTypeI == 7)%13  10%			vRandom = $rdist_erlang(MySeed, KStage, Mean);%13  10%		else%13  10%			vRandom = 0;%13  10%	end%13  10  13  10%	V(out) <+ V(in) + vRandom;%13  10  13  10%	// Limit the timestep to a minimum of 20 points per period of the%13  10%	//  noise frequency.%13  10%	bound_step(0.01/NoiseFreq);%13  10% end%13  10%endmodule")
				)
			)
		)
