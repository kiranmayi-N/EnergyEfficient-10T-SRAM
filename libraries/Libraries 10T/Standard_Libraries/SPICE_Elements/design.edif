					(string "`include %34%disciplines.vams%34  13  10%`include %34%constants.vams%34  13  10  13  10%module PseudoRandomBitStream(%13  10%	Out%13  10%);%13  10%	output Out;%13  10%	electrical Out;%13  10  13  10%	parameter real Delay = 0.0;%13  10%	parameter real Period = 1.0e-8;%13  10%	parameter real Risetime = 1.0E-9;%13  10%	parameter real Falltime = 1.0E-9;%13  10%	parameter integer Seed = 1;%13  10%	parameter real VHigh = 5;%13  10%	parameter real VLow = 0;%13  10  13  10%	real x;%13  10%	integer MySeed;%13  10%	integer Temp;%13  10%	%13  10%	analog begin%13  10%		@(initial_step) begin%13  10%			MySeed = Seed;%13  10%	   end%13  10%   	%13  10%		@(timer(Delay, Period)) begin%13  10%			Temp = $random(MySeed);%13  10%			x = (Temp >= 0) ? VHigh : VLow;%13  10%		end%13  10%		V(Out) <+ transition (x, 0.0, Risetime, Falltime);		%13  10%	end%13  10  13  10%endmodule // PseudoRandomBitStream%13  10%")
				)
			)
		)
