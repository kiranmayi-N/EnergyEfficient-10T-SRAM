			(view Bit
				(viewType SCHEMATIC)
				(interface
					(port Neg)
					(port Pos)
					(property
						(rename ANNOTATE_PERIOD_Neg "ANNOTATE.Neg")
						(string "[FormatAnnotation [ annotate port Neg ]]")
						(property InterfaceParameter
							(boolean
								(false)
							)
						)
					)
					(property
						(rename ANNOTATE_PERIOD_Pos "ANNOTATE.Pos")
						(string "[FormatAnnotation [ annotate port Pos ]]")
						(property InterfaceParameter
							(boolean
								(false)
							)
						)
					)
					(property
						(rename Calc_PERIOD_Freq "Calc.Freq")
						(string "1.0/${Calc.Period}")
						(property InterfaceParameter
							(boolean
								(false)
							)
						)
						(property Type
							(string "Double")
						)
					)
					(property
						(rename Calc_PERIOD_FullPulseWidth "Calc.FullPulseWidth")
						(string "if($PW-$LT, $LT+$HT, if($PW-$HT, $LT+$HT, 2*$PW))")
						(property InterfaceParameter
							(boolean
								(false)
							)
						)
						(property Type
							(string "Double")
						)
					)
					(property
						(rename Calc_PERIOD_Period "Calc.Period")
						(string "${Calc.FullPulseWidth}+$RT+$FT")
						(property InterfaceParameter
							(boolean
								(false)
							)
						)
						(property Type
							(string "Double")
						)
					)
					(property DELAY
						(string "0ns")
						(property Type
							(string "Double")
						)
						(comment "Delay time before the pattern.")
					)
					(property FT
						(string "1ns")
						(property Type
							(string "Double")
						)
						(comment "Fall time.")
					)
					(property Freq
						(string "${Calc.Freq}")
						(property InterfaceParameter
							(boolean
								(false)
							)
						)
						(property Type
							(string "Double")
						)
					)
					(property HT
						(string "10ns")
						(property Type
							(string "Double")
						)
						(comment "High time = R + TA, where TA is the time during a pulse where the current is on and R is the risetime.")
					)
					(property LT
						(string "10ns")
						(property Type
							(string "Double")
						)
						(comment "Low time = F + TZ, where TZ is the time during a pulse where the current is off and F is the falltime.")
					)
					(property OFF
						(string "0mA")
						(property Type
							(string "Double")
						)
						(comment "Off current")
					)
					(property ON
						(string "5mA")
						(property Type
							(string "Double")
						)
						(comment "On current")
					)
					(property PW
						(string "10ns")
						(property Type
							(string "Double")
						)
						(comment "Pulse width = R + TA = F + TZ, where TA is the time during a pulse where the current is on, TZ is the time during a pulse where the current is off, R - Risetime, F - Falltime.")
					)
					(property Period
						(string "${Calc.Period}")
						(property InterfaceParameter
							(boolean
								(false)
							)
						)
						(property Type
							(string "Double")
						)
					)
					(property ROUND
						(number 0)
						(comment "Rounding half-interval. A corner at time T is replaced by a smoothly differentiable polynomial in the interval (T%8211%RND,T+RND). The maximum RND is half the distance to the nearest neighboring corner.")
					)
					(property RT
						(string "1ns")
						(property Type
							(string "Double")
						)
						(comment "Rise time.")
					)
					(property
						(rename SPICE_PERIOD_MODEL "SPICE.MODEL")
						(string "[ ]")
						(property InterfaceParameter
							(boolean
								(false)
							)
