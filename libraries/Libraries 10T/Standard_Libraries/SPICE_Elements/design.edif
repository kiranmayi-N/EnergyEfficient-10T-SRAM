					(string "`include %34%disciplines.vams%34  13  10%`include %34%constants.vams%34  13  10  13  10%module Delay(%13  10%	n,%13  10%	ns,%13  10%	p,%13  10%	ps%13  10%);%13  10%	inout n;%13  10%	inout ns;%13  10%	inout p;%13  10%	inout ps;%13  10%	electrical n;%13  10%	electrical ns;%13  10%	electrical p;%13  10%	electrical ps;%13  10%	%13  10%	parameter real Delay = 0.0;%13  10%	parameter real Gain = 1.0;%13  10%	%13  10%	analog%13  10%		V(p,n) <+ delay(Gain*V(ps,ns), Delay);%13  10  13  10%endmodule // Delay%13  10%")
